  "scripts": {
    "asr:accept": "node video_editing/voice_adapter.cjs accept",
    "asr:check": "node video_editing/voice_adapter.cjs check",
    "asr:fetch": "node video_editing/download_srt.cjs",
    "asr:init": "node video_editing/voice_adapter.cjs init",
    "asr:local": "python video_editing/local_whisper.py",
    "asr:test": "python -m unittest discover -s video_editing -p test_local*.py && python -m unittest discover -s video_editing -p test_source_timing.py && python -m unittest discover -s video_editing -p test_chatcut_bridge.py && python -m unittest discover -s video_editing -p test_rough_cut.py",
    "asr:timing": "python video_editing/source_timing.py",
    "broll:search": "node video_editing/broll_adapter.cjs",
    "chatcut:status": "python video_editing/chatcut_bridge.py status",
    "check": "npm run remotion:typecheck",
    "edit:prepare": "node scripts/editing/cli.cjs prepare",
    "edit:test": "node --test scripts/editing/contract.test.cjs",
    "edit:validate": "node scripts/editing/cli.cjs validate",
    "inspect:input": "npm run inspect:input --prefix remotion-clone --",
    "install:all": "npm ci --prefix remotion-clone",
    "media:classify": "node video_editing/media_roles.cjs",
    "packaging:broll": "node video_editing/packaging_broll.cjs",
    "packaging:broll:test": "node --test video_editing/packaging_broll.test.cjs",
    "release:check": "python scripts/release/release.py check --root .",
    "release:test": "python -m unittest discover -s scripts/release -p test_*.py",
    "remotion:typecheck": "npm run typecheck --prefix remotion-clone",
    "render:review": "npm run render:review --prefix remotion-clone --",
    "review:project": "npm run review:project --prefix remotion-clone --",
    "setup:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup/doctor.ps1",
    "setup:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup/test-environment.ps1 && python -m unittest discover -s scripts/setup -p test_*.py",
    "studio": "npm run studio --prefix remotion-clone",
    "video:handoff": "node video_editing/handoff.cjs",
    "video:prepare": "node video_editing/editing.cjs",
    "video:test": "node --test video_editing/pipeline.test.cjs && python -m unittest discover -s video_editing -p test_resolve.py",
    "visual:assemble": "node video_editing/visual_workflow.cjs assemble",
    "visual:merge": "node video_editing/visual_workflow.cjs merge",
    "visual:plan": "node video_editing/visual_workflow.cjs plan",
    "visual:prepare": "node video_editing/visual_workflow.cjs prepare",
    "visual:refine": "node video_editing/visual_workflow.cjs refine",
    "visual:test": "node --test video_editing/media_roles.test.cjs video_editing/visual_workflow.test.cjs"
  },
  "version": "0.1.0"
}
